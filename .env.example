# LifeVault AI Environment Configuration Example
# Copy this file to .env or pass variables via --dart-define during build

# Google Gemini AI API Key (for Multimodal Vision OCR and AI Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Access Token (for Whisper STT Audio Transcription)
HUGGINGFACE_API_KEY=your_huggingface_token_here

# MongoDB Atlas URI (for Encrypted Cloud Synchronization)
MONGODB_URI=your_mongodb_connection_string_here

# MongoDB Collection Name
MONGODB_COLLECTION=lifevault
